    "dancing lights": {
      "name": "Dancing Lights",
      "command": "!Spawn {{ --name|Dancing Lights --qty|4 --size|0.5,0.5 --placement|burst 1 }}@{}",
      "endCommand": "",
      "applyOnFailure": false
    },
    "disguise self": {
      "name": "Disguise Self",
      "command": "!token-mod --set imgsrc|?^{Roll20 URL|}",
      "endCommand": "",
      "applyOnFailure": false
    },
    "hold person": {
      "name": "Hold Person",
      "command": "!tether target|{source}  target|{target}",
      "endCommand": "!untether target|{source} target|{target}",
      "applyOnFailure": false
    },
    "light": {
      "name": "Light",
      "command": "!token-mod --set emits_bright_light|on emits_low_light|on bright_light_distance|20 low_light_distance|20 --ids @{target|token_id}",
      "endCommand": "",
      "applyOnFailure": false
    },
    "sleep": {
      "name": "Sleep",
      "command": "!tether target|{source}  target|{target}",
      "endCommand": "!untether target|{source}  target|{target}",
      "applyOnFailure": false
